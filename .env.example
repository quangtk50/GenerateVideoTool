# =====================================================================
#  GenerateVideoTool - cấu hình. Copy thành .env rồi điền key.
#  Thiếu key nào thì module đó tự chạy ở chế độ giả lập (mock).
# =====================================================================

# === Web ===
HOST=127.0.0.1
PORT=8000
# Bật đăng nhập khi đưa lên VPS (để trống = không cần đăng nhập)
WEB_USER=
WEB_PASSWORD=

# === Claude (mọi agent: ý tưởng, biên kịch, phản biện, đạo diễn, QA, SEO, phân tích) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
# Model cho agent phụ (phản biện, QA, SEO). Để trống = dùng CLAUDE_MODEL
CLAUDE_MODEL_FAST=
CRITIC_ENABLED=1
CRITIC_MIN_SCORE=7
CRITIC_MAX_ROUNDS=2

# === Nguồn hình ===
# auto = đạo diễn chọn theo từng cảnh | ai_video | ai_image | stock
VISUAL_MODE=auto
# Nhà cung cấp video AI ưu tiên: seedance | fal
VIDEO_PROVIDER=seedance

# --- Seedance qua BytePlus ModelArk ---
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
SEEDANCE_MIN_DURATION=4
SEEDANCE_MAX_DURATION=15
# 1 = gửi seed lên API (chỉ bật nếu model hỗ trợ tham số seed)
SEEDANCE_SEND_SEED=0

# --- fal.ai: video AI (Kling, Wan, Veo...) + ảnh AI (Flux) ---
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
# Tham số riêng của model video, dạng JSON. VD: {"negative_prompt":"blur, distort"}
FAL_VIDEO_EXTRA=
FAL_IMAGE_MODEL=fal-ai/flux/schnell

# --- Pexels: video stock miễn phí ---
PEXELS_API_KEY=

# === Lời thoại (TTS): edge (miễn phí) | elevenlabs | fpt | none ===
TTS_PROVIDER=edge
EDGE_VOICE=vi-VN-HoaiMyNeural
EDGE_RATE=+8%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
FPT_API_KEY=
FPT_VOICE=banmai

# === Dựng video ===
DEFAULT_RESOLUTION=720p
RESOLUTION_OPTIONS=480p,720p,1080p
VIDEO_RATIO=9:16
FPS=30
# Font phụ đề (phải có trên máy). Windows: Arial | Linux/Docker: DejaVu Sans
SUB_FONT=Arial
SUB_WORDS_PER_LINE=4
MUSIC_VOLUME=0.18
TARGET_LUFS=-14
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# === QA bằng Claude vision (1 = bật) ===
QA_VISION=1

# === Đăng bài ===
# 1 = chỉ giả lập (an toàn khi thử). Đổi thành 0 để đăng thật.
PUBLISH_DRY_RUN=1
DEFAULT_PLATFORMS=youtube,tiktok
# YouTube: đặt file OAuth client vào data/secrets/youtube_client_secret.json rồi chạy: python -m app.cli youtube-auth
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=22
# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
# Facebook Page + Instagram (Meta Graph API)
META_GRAPH_VERSION=v23.0
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=

# === Chạy song song & lịch tự động ===
MAX_PARALLEL_RENDERS=3
MAX_CONCURRENT_PROJECTS=2
SCHEDULER_ENABLED=0
# Giờ tự tạo video mỗi ngày (giờ máy chủ), cách nhau dấu phẩy. VD: 08:30,19:45
AUTO_TIMES=
AUTO_DURATION=30
AUTO_PLATFORM_LABEL=TikTok
AUTO_APPROVE_SCRIPT=0
AUTO_PUBLISH=0
ANALYTICS_TIME=23:10

# === Chế độ thử ===
# auto = tự giả lập khi chưa có key; 1 = luôn giả; 0 = luôn gọi thật
MOCK_CLAUDE=auto
MOCK_SEEDANCE=auto
# 1 = giả lập toàn bộ fal/Pexels/TTS (chạy thử không cần mạng)
MOCK_MEDIA=auto
