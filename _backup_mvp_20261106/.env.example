# === Claude (viết kịch bản + phân cảnh) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# === Seedance qua BytePlus ModelArk ===
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
SEEDANCE_MODEL=dreamina-seedance-2-0-260128
# Độ phân giải mặc định trên form, và các lựa chọn hiển thị (phải được model hỗ trợ)
DEMO_RESOLUTION=480p
RESOLUTION_OPTIONS=480p,720p,1080p
VIDEO_RATIO=9:16
# Giới hạn thời lượng mỗi lần gọi (giây) theo model đang dùng
SEEDANCE_MIN_DURATION=4
SEEDANCE_MAX_DURATION=15
# 1 = gửi seed lên API (chỉ bật nếu model hỗ trợ tham số seed)
SEEDANCE_SEND_SEED=0
MAX_PARALLEL_RENDERS=3

# === Chế độ thử nghiệm ===
# auto = tự dùng dữ liệu giả khi chưa có API key; 1 = luôn giả; 0 = luôn gọi thật
MOCK_CLAUDE=auto
MOCK_SEEDANCE=auto

# === FFmpeg ===
FFMPEG_BIN=ffmpeg
DEMO_SIZE=360x640
DEMO_FPS=24
